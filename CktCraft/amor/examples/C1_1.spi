.options post probe=0
.option scale=1u
.global VDD GND gnd vdd

vdd vdd 0 5v
vin1 in1 0 pulse 0 5v 5n 0.1n 0.1n 25n 50n

.meas tran tO69r trig v(in1) val=2.5 rise=3
+ targ v(O69) val=2.5 rise=3
.meas tran tO69f trig v(in1) val=2.5 fall=2
+ targ v(O69) val=2.5 fall=2

.lib 'mod078/mod078.lib' TT
.tran 0.1n 200n
.print(V(O69))
.end
