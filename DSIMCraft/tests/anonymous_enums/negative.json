{
  "identity": "module top;enum {A,B} a;enum {C,D} b;initial a=b;endmodule",
  "integral": "module top;enum {A,B} a;initial a=1;endmodule",
  "duplicate": "module top;enum {A,A} a;endmodule",
  "overflow": "module top;enum logic {A=2} a;endmodule",
  "duplicate_value": "module top;enum {A=1,B=1} a;endmodule",
  "real_base": "module top;enum real {A,B} a;endmodule",
  "unsigned_narrow_negative": "module top;typedef enum bit[30:0] {A=-1} E;endmodule",
  "unsigned_narrow_parameter": "module top;parameter int P=-1;typedef enum bit[7:0] {A=P} E;endmodule",
  "unsigned_increment_overflow": "module top;typedef enum bit[31:0] {A=-1,B} E;endmodule",
  "unsigned_duplicate": "module top;typedef enum bit[31:0] {A=-1,B='1} E;endmodule",
  "unsigned_sized_truncation": "module top;typedef enum bit[7:0] {A=-32'sd1} E;endmodule",
  "unsigned_positive_overflow": "module top;typedef enum bit[7:0] {A=256} E;endmodule",
  "real_initializer": "module top;typedef enum {A=2.5} E;endmodule"
